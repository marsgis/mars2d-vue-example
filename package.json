{
  "name": "mars2d-vue-example",
  "version": "3.5.0",
  "description": "在Vue3技术栈下的Mars2D平台 功能示例 演示项目",
  "scripts": {
    "serve": "vite --host",
    "dev": "vite",
    "clean-cache": "rimraf node_modules/.cache/ && rimraf node_modules/.vite",
    "clean-lib": "rimraf node_modules",
    "preview": "vite preview",
    "build": "npm run lint && vite build",
    "build-devcen": "vite build --mode dev",
    "serve:dist": "http-server ./dist",
    "lint": "vue-tsc --noEmit --skipLibCheck && npm run lint:strict && npm run eslint",
    "lint:strict": "vue-tsc -p tsconfig.strict.json --noEmit --skipLibCheck",
    "lint:fix": "vue-tsc --noEmit --skipLibCheck && npm run eslint -- --fix",
    "eslint": "eslint ./src/**/*.{js,vue,ts}",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:coverage": "vitest run tests/unit --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@icon-park/svg": "^1.4.2",
    "@marsgis/editor": "^1.5.2",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.20.0",
    "core-js": "^3.50.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "localforage": "^1.10.0",
    "lodash": "^4.17.21",
    "mars2d": "^3.5.0",
    "monaco-editor": "^0.52.2",
    "nprogress": "^0.2.0",
    "split.js": "^1.6.5",
    "uuid": "^14.0.3",
    "vue": "^3.5.43",
    "vue-color-kit": "^1.0.6",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/leaflet": "^1.9.8",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "consola": "^3.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "less": "^4.9.1",
    "lint-staged": "^17.6.0",
    "neostandard": "^0.14.1",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "rollup-plugin-copy": "~3.5.0",
    "terser": "^5.51.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vite-plugin-style-import": "^2.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "$@typescript-eslint/eslint-plugin",
    "@typescript-eslint/parser": "$@typescript-eslint/parser"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marsgis/mars2d-vue-example.git"
  },
  "bugs": {
    "url": "https://github.com/marsgis/mars2d-vue-example/issues",
    "email": "wh@marsgis.cn"
  },
  "keywords": [
    "marsgis",
    "mars2d",
    "leaflet",
    "vue",
    "vue3",
    "gis",
    "webgis"
  ],
  "author": "mars2d",
  "license": "Apache-2.0",
  "homepage": "http://mars2d.cn",
  "lint-staged": {
    "*.{js,jsx,vue,ts,tsx}": [
      "eslint --fix"
    ]
  }
}
