{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noImplicitAny": true,
    "strictNullChecks": true,
    // monaco-editor 0.57 起类型仅在 package.json exports 中声明，必须保留 exports 解析；
    // vuex 4 的 exports 未声明 types，故用 paths 显式指向其类型入口
    "paths": {
      "@mars/*": ["./src/*"],
      "vuex": ["./node_modules/vuex/types/index.d.ts"]
    }
  },
  "include": [
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/components/**/*.vue",
    "src/widgets/**/*.ts",
    "src/widgets/**/*.tsx",
    "src/widgets/**/*.vue",
    "src/utils/**/*.ts",
    "src/utils/**/*.tsx",
    "src/utils/**/*.vue",
    "src/misc/**/*.ts",
    "src/misc/**/*.d.ts",
    "src/pages/**/*.ts",
    "src/pages/**/*.tsx",
    "src/pages/**/*.vue"
  ],
  "exclude": ["node_modules", "dist", "src/example/**"]
}
